{
    "model": {
        "bos_token_id": 1,
        "context_length": 8192,
        "decoder": {
            "session_options": {
                "log_id": "onnxruntime-genai",
                "provider_options": [
                    {
                        "RyzenAI": {
                            "external_data_file": "model_jit.pb.bin",
                            "hybrid_opt_free_after_prefill": "1",
                            "hybrid_opt_max_seq_length": "4096"
                        }
                    }
                ]
            },
            "filename": "model_jit.onnx",
            "head_size": 64,
            "hidden_size": 576,
            "inputs": {
                "input_ids": "input_ids",
